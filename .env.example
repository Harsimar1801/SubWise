# Copy to .env; replace credentials with your local PostgreSQL credentials.
# Use a dedicated development database. Never commit the real connection string.
DATABASE_URL="postgresql://subwise:change-me@localhost:5432/subwise?schema=public&connect_timeout=5"
# Neon deploy supplies both variables: pooled URL above, direct URL below.
# Local PostgreSQL can use the same URL for both.
DATABASE_URL_UNPOOLED="postgresql://subwise:change-me@localhost:5432/subwise?schema=public&connect_timeout=5"

# Generate a random secret of at least 32 characters. Never commit real values.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Explicitly allow localhost HTTP when testing a production build locally only.
AUTH_ALLOW_LOCAL_HTTP="false"
# Existing SMTP server or a local mail catcher; reset requests return 503 if unset.
SMTP_URL=""
SMTP_FROM=""
# Terminal bootstrap only: npm run auth:bootstrap (not npm run auth).
# All three values are required. Password: 9–128 characters with uppercase,
# lowercase and a special character. Prefer the PowerShell Read-Host procedure
# in docs/AUTHENTICATION.md; dotenv expands $ unless escaped as \$ in .env files.
# Remove these values after creating the first admin.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
